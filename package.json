{
	"name": "expiry-dashboard",
	"version": "1.0.0",
	"description": "لوحة تحليل الصلاحيات - صيدلية المتحدة",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"build": "electron-builder --win --x64"
	},
	"build": {
		"appId": "com.unitedpharmacy.expiry",
		"productName": "لوحة الصلاحيات",
		"win": {
			"target": "portable",
			"icon": "icon.ico"
		},
		"portable": {
			"artifactName": "expiry-dashboard.exe"
		},
		"files": [
			"index.html",
			"main.js"
		]
	},
	"devDependencies": {
		"electron": "^28.0.0",
		"electron-builder": "^24.0.0"
	}
}